{
  "schemaVersion": 1,
  "profileName": "Kortexa Smarty",
  "capture": {
    "width": 1280,
    "height": 720,
    "framesPerSecond": 30,
    "mirrorVideo": true,
    "audioSampleRate": 48000,
    "audioChannels": 1,
    "virtualAudioOutputDeviceID": "ai.kortexa.aicamera.audio.device",
    "microphoneGain": 1,
    "speechGain": 1
  },
  "endpoints": [
    {
      "id": "smarty-objects",
      "adapter": "kortexaDetection",
      "baseURL": "https://api.kortexa.ai/vision",
      "model": "yolo26n.pt",
      "auth": {
        "kind": "apiKeyKeychain",
        "reference": "kortexa-api",
        "header": "x-api-key",
        "prefix": ""
      },
      "timeoutSeconds": 4,
      "options": {
        "confidence": 0.35
      }
    },
    {
      "id": "smarty-asr",
      "adapter": "openAITranscription",
      "baseURL": "https://api.kortexa.ai",
      "model": "Qwen/Qwen3-ASR-1.7B",
      "auth": {
        "kind": "apiKeyKeychain",
        "reference": "kortexa-api",
        "header": "x-api-key",
        "prefix": ""
      },
      "timeoutSeconds": 20,
      "options": {}
    },
    {
      "id": "smarty-agent",
      "adapter": "openAIChat",
      "baseURL": "https://api.kortexa.ai",
      "model": "qwen-3.8-27b",
      "auth": {
        "kind": "apiKeyKeychain",
        "reference": "kortexa-api",
        "header": "x-api-key",
        "prefix": ""
      },
      "timeoutSeconds": 30,
      "options": {
        "temperature": 0.4,
        "max_tokens": 256
      }
    },
    {
      "id": "smarty-vision",
      "adapter": "openAIVision",
      "baseURL": "https://api.kortexa.ai",
      "model": "lfm2.5-vl-3b",
      "auth": {
        "kind": "apiKeyKeychain",
        "reference": "kortexa-api",
        "header": "x-api-key",
        "prefix": ""
      },
      "timeoutSeconds": 20,
      "options": {}
    },
    {
      "id": "smarty-speech",
      "adapter": "openAISpeech",
      "baseURL": "https://api.kortexa.ai",
      "model": "qwen3-tts-customvoice-1.7b",
      "auth": {
        "kind": "apiKeyKeychain",
        "reference": "kortexa-api",
        "header": "x-api-key",
        "prefix": ""
      },
      "timeoutSeconds": 60,
      "options": {
        "streamingPCM": true,
        "pcmSampleRate": 24000
      }
    },
    {
      "id": "smarty-realtime",
      "adapter": "openAIRealtime",
      "baseURL": "https://api.kortexa.ai",
      "model": "qwen-3.8-27b",
      "auth": {
        "kind": "apiKeyKeychain",
        "reference": "kortexa-api",
        "header": "x-api-key",
        "prefix": ""
      },
      "timeoutSeconds": 30,
      "options": {
        "voice": "adrian"
      }
    }
  ],
  "pipeline": {
    "videoStages": [
      {
        "id": "hands",
        "kind": "handGesture",
        "enabled": true,
        "maximumRateHz": 8,
        "maximumFrameAgeMilliseconds": 250,
        "options": {}
      },
      {
        "id": "objects",
        "kind": "objectDetection",
        "enabled": true,
        "endpointID": "smarty-objects",
        "maximumRateHz": 2,
        "maximumFrameAgeMilliseconds": 1000,
        "options": {
          "confidence": 0.35
        }
      },
      {
        "id": "vision",
        "kind": "visionLanguage",
        "enabled": false,
        "endpointID": "smarty-vision",
        "maximumRateHz": 0.2,
        "maximumFrameAgeMilliseconds": 2000,
        "prompt": "Describe only visual facts useful to a conversational camera assistant.",
        "options": {}
      }
    ],
    "conversation": {
      "enabled": true,
      "realtimeEnabled": false,
      "realtimeEndpointID": "smarty-realtime",
      "transcriptionEnabled": true,
      "transcriptionEndpointID": "smarty-asr",
      "agentEndpointID": "smarty-agent",
      "speechEndpointID": "smarty-speech",
      "systemPrompt": "You are an assistant present in a live camera conversation. Respond briefly and never claim to see facts that are not in the supplied scene context.",
      "respondToFinalTranscripts": true,
      "activationMode": "wakePhrase",
      "wakePhrase": "Hey Kortexa",
      "wakeWindowSeconds": 8,
      "includeSceneSummary": true,
      "speechVoice": "adrian",
      "utteranceSeconds": 3,
      "bargeIn": true,
      "respondToGestures": true,
      "gestureCooldownSeconds": 2
    }
  },
  "overlays": {
    "enabled": true,
    "showDetectionBoxes": true,
    "showGestureLabels": true,
    "showTranscript": true,
    "showAgentResponse": true,
    "showStatus": true,
    "resultTTLSeconds": 4,
    "accentHex": "#59F3C2",
    "script": {
      "enabled": true,
      "maxScriptBytes": 65536,
      "maximumFps": 30,
      "defaultTTLSeconds": 30,
      "maximumTTLSeconds": 60,
      "allowSceneData": false
    }
  },
  "privacy": {
    "networkMode": "allowListed",
    "allowedHosts": [
      "api.kortexa.ai"
    ],
    "grants": [
      {
        "endpointID": "smarty-objects",
        "allowedData": ["rawFrame"]
      },
      {
        "endpointID": "smarty-asr",
        "allowedData": ["rawAudio"]
      },
      {
        "endpointID": "smarty-agent",
        "allowedData": ["promptText", "transcript", "sceneMetadata"]
      },
      {
        "endpointID": "smarty-vision",
        "allowedData": ["rawFrame", "promptText"]
      },
      {
        "endpointID": "smarty-speech",
        "allowedData": ["promptText"]
      },
      {
        "endpointID": "smarty-realtime",
        "allowedData": ["rawAudio", "transcript", "promptText", "sceneMetadata"]
      }
    ],
    "persistMedia": false
  }
}
