{
  "schemaVersion": 1,
  "profileName": "Kortexa local",
  "capture": {
    "width": 1280,
    "height": 720,
    "framesPerSecond": 30,
    "mirrorVideo": true,
    "audioSampleRate": 48000,
    "audioChannels": 1,
    "virtualAudioOutputDeviceID": "ai.kortexa.aicamera.audio.device",
    "microphoneGain": 1,
    "speechGain": 1
  },
  "endpoints": [
    {
      "id": "objects",
      "adapter": "kortexaDetection",
      "baseURL": "http://127.0.0.1:4001",
      "auth": {
        "kind": "none",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeoutSeconds": 4,
      "options": {
        "confidence": 0.35
      }
    },
    {
      "id": "asr",
      "adapter": "kortexaPCMTranscription",
      "baseURL": "http://127.0.0.1:4002",
      "auth": {
        "kind": "none",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeoutSeconds": 20,
      "options": {}
    },
    {
      "id": "agent",
      "adapter": "openAIChat",
      "baseURL": "http://127.0.0.1:2030",
      "model": "mlx-community/Qwen3.5-2B-MLX-4bit",
      "auth": {
        "kind": "none",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeoutSeconds": 30,
      "options": {
        "temperature": 0.4,
        "max_tokens": 256
      }
    },
    {
      "id": "vision",
      "adapter": "openAIVision",
      "baseURL": "http://127.0.0.1:2052",
      "path": "/chat/completions",
      "model": "LiquidAI/LFM2.5-VL-450M-MLX-8bit",
      "auth": {
        "kind": "none",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeoutSeconds": 20,
      "options": {}
    },
    {
      "id": "speech",
      "adapter": "openAISpeech",
      "baseURL": "http://127.0.0.1:4003",
      "model": "qwen3-tts-customvoice-1.7b",
      "auth": {
        "kind": "none",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeoutSeconds": 60,
      "options": {
        "streamingPCM": true
      }
    }
  ],
  "pipeline": {
    "videoStages": [
      {
        "id": "hands",
        "kind": "handGesture",
        "enabled": true,
        "maximumRateHz": 8,
        "maximumFrameAgeMilliseconds": 250,
        "options": {}
      },
      {
        "id": "objects",
        "kind": "objectDetection",
        "enabled": true,
        "endpointID": "objects",
        "maximumRateHz": 2,
        "maximumFrameAgeMilliseconds": 1000,
        "options": {
          "confidence": 0.35
        }
      },
      {
        "id": "vision",
        "kind": "visionLanguage",
        "enabled": false,
        "endpointID": "vision",
        "maximumRateHz": 0.2,
        "maximumFrameAgeMilliseconds": 2000,
        "prompt": "Describe only visual facts useful to a conversational camera assistant.",
        "options": {}
      }
    ],
    "conversation": {
      "enabled": true,
      "transcriptionEnabled": true,
      "transcriptionEndpointID": "asr",
      "agentEndpointID": "agent",
      "speechEndpointID": "speech",
      "systemPrompt": "You are an assistant present in a live camera conversation. Respond briefly and never claim to see facts that are not in the supplied scene context.",
      "respondToFinalTranscripts": true,
      "activationMode": "wakePhrase",
      "wakePhrase": "Hey Kortexa",
      "wakeWindowSeconds": 8,
      "includeSceneSummary": true,
      "speechVoice": "aiden",
      "utteranceSeconds": 3,
      "bargeIn": true,
      "respondToGestures": true,
      "gestureCooldownSeconds": 2
    }
  },
  "overlays": {
    "enabled": true,
    "showDetectionBoxes": true,
    "showGestureLabels": true,
    "showTranscript": true,
    "showAgentResponse": true,
    "showStatus": true,
    "resultTTLSeconds": 4,
    "accentHex": "#59F3C2",
    "script": {
      "enabled": true,
      "maxScriptBytes": 65536,
      "maximumFps": 30,
      "defaultTTLSeconds": 30,
      "maximumTTLSeconds": 60,
      "allowSceneData": false
    }
  },
  "privacy": {
    "networkMode": "localOnly",
    "allowedHosts": [],
    "grants": [],
    "persistMedia": false
  }
}
